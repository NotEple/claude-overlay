# Copy to .env and fill in your values

PORT=3001
CLIENT_URL=http://localhost:5173

# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Your Twitch username (you — the owner)
OWNER_TWITCH_USERNAME=your_twitch_username

# From https://dev.twitch.tv/console → Your Application
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret

# Must match exactly what you set in the Twitch dev console
# Local: http://localhost:3001/auth/callback
# Production: https://your-render-url.onrender.com/auth/callback
TWITCH_REDIRECT_URI=http://localhost:3001/auth/callback
# Separate broadcaster authorization used by the Studio Events tab.
TWITCH_EVENTS_REDIRECT_URI=http://localhost:3001/auth/events/callback
EVENT_CHANNELS=vicksy,wixels
# Dedicated account used to send automated chat messages.
CHAT_BOT_USERNAME=dankchapbot
# Neon/Postgres stores whitelist entries and encrypted broadcaster tokens.
DATABASE_URL=
# 32 random bytes encoded as base64. Keep this stable or stored tokens cannot be decrypted.
TWITCH_TOKEN_ENCRYPTION_KEY=
PUBLIC_SERVER_URL=http://localhost:3001
# Twitch requires a public HTTPS callback; use the production URL or an HTTPS tunnel locally.
TWITCH_EVENTSUB_CALLBACK_URL=http://localhost:3001/twitch/eventsub
TWITCH_EVENTSUB_SECRET=

# LowDB storage for canvas/studio state. Render's free filesystem is ephemeral;
# this directory is intended for local development unless persistent disk is configured.
DATA_DIR=./data
# Uploaded media is also ephemeral on Render without persistent object/disk storage.
UPLOAD_DIR=./uploads
